NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=

RESEND_API_KEY=
RESEND_FROM=Yide Acompanha <noreply@SEUDOMINIO.com>

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Opcional: usado pelo cron diário. Gerar com: openssl rand -hex 32
CRON_SECRET=

# Opcional: usado pela síntese de satisfação. Get em https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Sentry (monitoramento de erros). Public DSN — exposto no client é seguro.
# Get em https://sentry.io/settings/<org>/projects/<project>/keys/
NEXT_PUBLIC_SENTRY_DSN=

# Opcional: token pra subir source maps no build (stack traces legíveis em prod).
# Get em https://sentry.io/settings/account/api/auth-tokens/ (scope: project:releases)
# Sem ele, Sentry funciona mas mostra código minificado nos erros.
SENTRY_AUTH_TOKEN=

# Zenvia Voz (ex-TotalVoice) - ligações de voz no módulo /ligacoes (opcional).
ZENVIA_VOICE_TOKEN=

# Editor de vídeo IA (Shotstack) - opcional. Cadastro em https://shotstack.io
SHOTSTACK_API_KEY=
SHOTSTACK_ENV=sandbox

# Opcional: Brave Search API key para pesquisa de tendências no cronograma de conteúdo.
# Get em https://api.search.brave.com/
SEARCH_API_KEY=

# Opcional: Evolution API para envio de relatórios semanais via WhatsApp.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=

# Google Drive - upload de vídeos pelo sistema (opcional). Organiza em
# Cliente / Mês / Categoria dentro da pasta raiz. Sem isso, a entrega de
# captação continua pedindo o link do Drive colado à mão.
# ID da pasta raiz: o trecho depois de /folders/ na URL da pasta.
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# Opção A (recomendada com Google Workspace): service account. A pasta raiz
# PRECISA estar num Drive compartilhado e a service account ser membro como
# "Gerente de conteúdo" (service account não tem cota no Meu Drive).
# Cole o JSON da chave inteiro ou em base64 (base64 -i chave.json).
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
# Opção B: OAuth de um usuário Google (arquivos ficam no Meu Drive dele).
# Tem prioridade sobre a opção A quando os 3 estão preenchidos.
# Escopo necessário: https://www.googleapis.com/auth/drive
GOOGLE_DRIVE_OAUTH_CLIENT_ID=
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN=
# Opcional: segredo do token que amarra preparar → confirmar envio.
# Sem ele, é derivado do SUPABASE_SERVICE_ROLE_KEY. Gere com: openssl rand -hex 32
GOOGLE_DRIVE_UPLOAD_TOKEN_SECRET=
